{
  "compilerOptions": {
    "module": "ESNext",
    "target": "esnext",
    "rootDir": "./src/js",
    "outDir": "lib",
    "declaration": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "lib": [
    "es2017",
    "esnext",
    "node"
  ],
  "include": [
    "src/js/**/*.ts"
  ],
  "exclude": [
    "src/js/**/*.spec.ts"
  ]
}
